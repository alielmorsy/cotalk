{
  "name": "co-talk",
  "version": "0.1.1",
  "description": "Let Claude Code, Antigravity and Codex sessions on one machine share a board, ask each other questions, and hand off tasks.",
  "keywords": [
    "multi-agent",
    "coordination",
    "mcp",
    "claude-code",
    "codex",
    "antigravity"
  ],
  "author": "Ali Elmorsy",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alielmorsy/cotalk.git"
  },
  "homepage": "https://github.com/alielmorsy/cotalk#readme",
  "bugs": "https://github.com/alielmorsy/cotalk/issues",
  "type": "module",
  "bin": {
    "cotalk": "bin/cotalk.js"
  },
  "files": [
    "bin/",
    "daemon/",
    "lib/",
    "hooks/",
    "skills/",
    "statusline/",
    ".claude-plugin/",
    ".codex-plugin/",
    ".agents/",
    ".mcp.json",
    "hooks.json",
    "plugin.json",
    "gemini-extension.json",
    "GEMINI.md"
  ],
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "test": "node --disable-warning=ExperimentalWarning --import ./test/clean-env.js --test test/*.test.js",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "vite": "^7.3.7"
  }
}
