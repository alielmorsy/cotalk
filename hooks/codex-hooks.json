{
  "hooks": {
    "SessionStart": [
      { "hooks": [ { "type": "command", "command": "node \"${PLUGIN_ROOT}/hooks/codex.js\" session-start", "timeout": 15 } ] }
    ],
    "UserPromptSubmit": [
      { "hooks": [ { "type": "command", "command": "node \"${PLUGIN_ROOT}/hooks/codex.js\" user-prompt", "timeout": 5 } ] }
    ],
    "Stop": [
      { "hooks": [ { "type": "command", "command": "node \"${PLUGIN_ROOT}/hooks/codex.js\" stop", "timeout": 10 } ] }
    ]
  }
}
